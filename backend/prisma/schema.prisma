// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String?    // null for OAuth users
  googleId   String?    @unique
  firstName  String?    // null until updated in profile
  lastName   String?    // null until updated in profile
  createdAt  DateTime   @default(now())
  updatedAt  DateTime?  @updatedAt 
  lastLogin  DateTime?

  achievements UserAchievement[]
  userStats    UserStat[]
  userTasks    UserTask[]
  userLogs     UserLog[]

  @@map("users")
}

model Achievement {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  iconPath    String?
  category    String?
  metric      String? // e.g. "login", "task_completed"
  targetValue Int?    // e.g. 7 for "7-day-streak"
  
  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            Int       @id @default(autoincrement())
  userId        Int
  achievementId Int
  dateUnlocked  DateTime?
  status        Boolean   @default(false)
  progress      Int       @default(0)

  user          User      @relation(fields: [userId], references: [id])
  achievement   Achievement @ relation(fields: [achievementId], references: [id])

  @@map("user_achievements")
  @@unique([userId, achievementId]) // prevent duplicates
}

model Category {
  id            Int       @id @default(autoincrement())
  name          String    @unique // Strength, Agility, Intelligence, Vitality, Perception
  description   String?

  tasks         Task[]
  userStats     UserStat[]

  @@map("categories")
}

model Task {
  id            Int       @id @default(autoincrement())
  categoryId    Int
  name          String    @unique
  requirement   String    
  xpValue       Int       @default(50)
  targetValue Int?    // e.g. 3 for 3 leetcode problems"

  category      Category  @relation(fields: [categoryId], references: [id])

  userTasks     UserTask[]
  @@map("tasks")
}

model UserTask {
  id            Int       @id @default(autoincrement())
  taskId        Int       
  userId        Int       
  updatedAt     DateTime  @updatedAt
  progress      Int       @default(0)
  isActive      Boolean   @default(true)

  user          User      @relation(fields: [userId], references: [id])
  task          Task      @relation(fields: [taskId], references: [id])

  userTaskCompletions     UserTaskCompletion[]

  @@unique([userId, taskId], name: "userId_taskId")
  @@index([userId, isActive])
  @@map("user_tasks")
}

model UserTaskCompletion {
  id            Int       @id @default(autoincrement())
  userTaskId    Int       
  completedAt   DateTime?
  xpEarned      Int
  metadata      Json?

  userTask      UserTask      @relation(fields: [userTaskId], references: [id])

  @@index([userTaskId, completedAt])
  @@map("user_task_completions")
}

model UserStat {
  id            Int       @id @default(autoincrement())
  userId        Int
  categoryId    Int
  currentXP     Int       @default(0)
  statLevel     Int       @default(10)

  category      Category  @relation(fields: [categoryId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@map("user_stats")
}

model UserLog {
  id            Int       @id @default(autoincrement())
  userId        Int
  type          String    // "login", "task_completed", "workout"
  timestamp     DateTime  @default(now())
  metadata      Json?     // optional, { taskId: 42, duration: 30 }

  user          User      @relation(fields: [userId], references: [id])

  @@map("user_logs")
  @@index([userId, type])
}